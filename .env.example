# No API keys are needed for MusicBrainz or Apple's iTunes Search API.
APP_ENV=development
DATABASE_PATH=data/music.sqlite3
COOKIE_SECURE=false
SESSION_DAYS=30
# MusicBrainz requires an identifying application User-Agent. Set a real contact
# URL or email before deployment. No OAuth/token is needed for public metadata.
MUSICBRAINZ_USER_AGENT=AI-Music-Discovery/1.0 (https://github.com/scrieorice123456-ctrl/ai-music-discovery)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
ITUNES_BASE_URL=https://itunes.apple.com
ITUNES_COUNTRY=ro
# Disable only for intentionally air-gapped deployments/tests.
EXTERNAL_APIS_ENABLED=true
CATALOG_CACHE_HOURS=24
MAX_UPLOAD_MB=30
MAX_UNCOMPRESSED_MB=80
MAX_IMPORT_EVENTS=100000
